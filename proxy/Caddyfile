# proxy: the only container open to the internet
# caddy gets the https certificate by itself and sends each request to the right container
{$DOMAIN} {
	encode gzip

	# api, websockets, face library and health check go to the backend
	@backend path /api/* /ws /esp /cam /vendor/* /healthz
	handle @backend {
		reverse_proxy backend:3000
	}

	# everything else is the website (frontend)
	handle {
		reverse_proxy frontend:8080
	}
}
