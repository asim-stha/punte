# Settings for the Punte containers.
# Copy this file to .env in the same folder and fill in real values. Never commit .env.

# Domain name of the server (use localhost when testing on your computer)
DOMAIN=localhost

# Website password, 8 or more characters
APP_PASSWORD=

# Secret shared with the ESP32 (must match ESP_TOKEN in secrets.h), 16 or more characters
ESP_TOKEN=

# Password of the database container
POSTGRES_PASSWORD=

# Model used when the AI runs on the server
OLLAMA_MODEL=llama3.2:3b

# Where data is kept: postgres (default) | file | supabase
# STORAGE=postgres

# Optional second copy of the data in Supabase
# STORAGE_MIRROR=supabase
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=

# Nightly backups to Azure Blob storage (used by infra/enable-backups.sh, the vm logs in with its own identity)
# BACKUP_STORAGE_ACCOUNT=
# BACKUP_CONTAINER=backups

# Only for running the backend without Docker (npm run dev inside backend/)
# STORAGE=file
# DATA_DIR=./data
# PUBLIC_DIR=../frontend/dist
